generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  color     String
  // Meta MENSAL de gasto da categoria (card "Orçamento do mês" no Dashboard).
  // null = sem meta; só faz sentido em categorias EXPENSE.
  budgetAmount Decimal? @db.Decimal(12, 2)
  // Movimento entre bolsos seus (depósito/retirada de caixinha), não ganho nem
  // gasto: fica fora de Receitas/Despesas/Saldo do mês e do "Descoberto".
  // O patrimônio e o fluxo de caixa continuam contando — ver lib/calc.ts.
  isTransfer Boolean @default(false)
  createdAt DateTime     @default(now())
  items     Item[]
  entries   MonthlyEntry[]
}

model Item {
  id         String         @id @default(cuid())
  name       String
  category   Category       @relation(fields: [categoryId], references: [id])
  categoryId String
  dueDay     Int?
  // Frequência da recorrência em meses (1=mensal, 2=bimestral, 3=trimestral…):
  // o provisionamento e o "Copiar mês anterior" respeitam a cadência.
  intervalMonths Int  @default(1)
  // Regra de data por dia útil (ex.: 5 = 5º dia útil): a data varia por mês;
  // quando setado, dueDay é ignorado e purchaseDate é calculada por mês.
  businessDay   Int?
  // Mês (1-12) em que a conta RENOVA/vence anualmente (seguro, anuidade…):
  // gera alertas no Dashboard, na tela do Mês e no Telegram.
  renewalMonth  Int?
  // Renovação parcelada: valor TOTAL anual + nº de parcelas (seguro em 4-5x
  // no cartão). Provisiona V÷N como linhas do item nos meses da renovação;
  // as parcelas reais no cartão consomem a provisão (como assinaturas).
  renewalAmount       Decimal? @db.Decimal(12, 2)
  renewalInstallments Int?
  // Reajuste anual: no mês adjustMonth (1-12), o valor sobe adjustPercent %
  // OU adjustAmount reais (um dos dois), composto a cada aniversário.
  adjustMonth   Int?
  adjustPercent Decimal? @db.Decimal(5, 2)
  adjustAmount  Decimal? @db.Decimal(12, 2)
  active     Boolean        @default(true)
  notes      String?
  createdAt  DateTime       @default(now())
  entries    MonthlyEntry[]
  subscription CardSubscription?

  @@index([categoryId])
}

model CreditCard {
  id        String         @id @default(cuid())
  name      String
  color     String
  // Dia de fechamento da fatura (1-31). Compra APÓS o fechamento cai na
  // fatura do mês seguinte — usado pela importação de CSV para rotear cada
  // compra pela data. null = importar tudo no primeiro mês em aberto.
  closingDay Int?
  // Dia de vencimento da fatura (1-31): define em QUE MÊS a fatura fechada é
  // paga — e portanto a competência do lançamento. Vencimento <= fechamento
  // significa pagar no mês seguinte ao fechamento (Bradesco: fecha 27, vence
  // 10). null = competência é o próprio mês do fechamento.
  dueDay     Int?
  // Limite de compras (para a barra de uso na tela Cartões). Auto-atualizado
  // pela importação da fatura; editável no formulário do cartão.
  limitAmount Decimal? @db.Decimal(12, 2)
  // Cartão padrão do bot: comandos sem nome de cartão (estorno, antecipei)
  // caem aqui. No máximo um true — as actions zeram os demais ao marcar.
  isDefault  Boolean        @default(false)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  entries   MonthlyEntry[]
  transactions CardTransaction[]
  subscriptions CardSubscription[]
}

// Assinatura cobrada no cartão (YouTube, Spotify…): provisionada como LINHA
// PRÓPRIA no mês (Item recorrente, fora do consolidado do cartão), com
// duração escolhida. Quando a cobrança real chega na fatura (CSV/share), a
// linha do mês é CONSUMIDA: marcada como paga e zerada — o valor passa a
// viver dentro do consolidado do cartão, sem contar em dobro.
model CardSubscription {
  id          String     @id @default(cuid())
  card        CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String
  // Item recorrente que carrega as linhas provisionadas no /mes.
  item        Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId      String?    @unique
  /** Nome fantasia: o que você lê na tela do Mês e em Itens. */
  description String
  /**
   * Como o estabelecimento aparece NA FATURA. É por este texto que a cobrança
   * real é reconhecida e a linha do mês é consumida.
   *
   * Existe separado porque os dois divergem com frequência: o app mostra
   * "YouTube Premium" e a fatura escreve "Google Youtubepremium" — e
   * `descriptionsMatch` compara por conter, então o espaço já basta para não
   * casar. Mesmo padrão de `CardTransaction.bankDescription`.
   *
   * null = casa pelo próprio `description` (comportamento anterior).
   */
  bankDescription String?
  amount      Decimal    @db.Decimal(12, 2)
  // Dia do mês em que a cobrança acontece (1-31).
  chargeDay   Int
  // Duração em meses da provisão (assinaturas que vão acabar duram menos).
  months      Int        @default(12)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  transactions CardTransaction[]
}

// Extrato do cartão: cada compra/estorno individual que compõe o lançamento
// consolidado do mês (MonthlyEntry com cardId). Parcelas geram 1 registro por
// mês (seq/count). Valor negativo = estorno.
model CardTransaction {
  id               String     @id @default(cuid())
  card             CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId           String
  month            DateTime   @db.Date
  description      String
  // Texto ORIGINAL do banco, gravado pela importação de fatura. `description` é
  // livre para o usuário renomear (apelido legível); o casamento com a próxima
  // fatura usa `bankDescription ?? description`. Sem isso, renomear uma parcela
  // desligava a identidade do plano e a fatura seguinte duplicava a cauda —
  // medido: R$ 63,76 num plano renomeado do Bradesco.
  // null nas linhas antigas e nas criadas à mão: cai no comportamento anterior.
  bankDescription  String?
  amount           Decimal    @db.Decimal(12, 2)
  purchaseDate     DateTime?  @db.Date
  installmentSeq   Int?
  installmentCount Int?
  // Pagamento antecipado da fatura (valor negativo, lançado manualmente):
  // preservado quando o CSV substitui o mês (no CSV ele vira "Pagamento
  // recebido", que é ignorado — sem a flag o reimport apagaria o abatimento).
  prepayment       Boolean    @default(false)
  // Provisão de assinatura (aponta para o cadastro): substituída pela
  // cobrança real quando ela chega (CSV substitui o mês; share troca a
  // provisão de descrição correspondente).
  subscription     CardSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  createdAt        DateTime   @default(now())

  @@index([cardId, month])
}

model MonthlyEntry {
  id               String      @id @default(cuid())
  item             Item?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId           String?
  description      String?
  // Data do lançamento (avulsos sem cartão; cartão usa a data só para rotear a fatura).
  purchaseDate     DateTime?   @db.Date
  category         Category?   @relation(fields: [categoryId], references: [id])
  categoryId       String?
  card             CreditCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardId           String?
  installmentId    String?
  installmentSeq   Int?
  installmentCount Int?
  month            DateTime    @db.Date
  plannedAmount    Decimal     @db.Decimal(12, 2)
  paid             Boolean     @default(false)
  paidAmount       Decimal?    @db.Decimal(12, 2)
  paidDate         DateTime?   @db.Date
  createdAt        DateTime    @default(now())
  // Caixinha do movimento (depósito e retirada). Sem isto, desfazer dependia
  // de reler o nome na descrição — e nome de caixinha o usuário edita.
  reserveBox       ReserveBox? @relation(fields: [reserveBoxId], references: [id], onDelete: SetNull)
  reserveBoxId     String?
  // Só na retirada: a conta que ela pagou. Campo solto (mesmo padrão do
  // installmentId) — é o que permite devolver o dinheiro exato ao desmarcar a
  // baixa, em vez de adivinhar por mês/valor/data.
  withdrawalForId  String?

  @@unique([itemId, month])
  @@index([month])
  @@index([categoryId])
  @@index([cardId])
  @@index([installmentId])
  @@index([withdrawalForId])
}

/**
 * Passkey (WebAuthn) de um aparelho, usada para DESTRAVAR o app — não para
 * logar. O login por senha continua intacto de propósito: passkey é presa ao
 * aparelho e ao domínio, então sem a senha um celular novo deixaria o dono de
 * fora.
 *
 * App de dono único: não há userId. Cada linha é um aparelho.
 */
model Passkey {
  id             String   @id @default(cuid())
  /** ID da credencial em base64url — o que o navegador devolve e o servidor procura. */
  credentialId   String   @unique
  /** Chave pública em base64url; verifica a assinatura de cada desbloqueio. */
  publicKey      String
  /** Contador anti-clonagem do autenticador; só cresce. */
  counter        Int      @default(0)
  /** "internal", "hybrid"… ajuda o navegador a sugerir o autenticador certo. */
  transports     String?
  /** Nome que você dá ao aparelho ("iPhone do Cristian"). */
  label          String
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime?
}

model ReserveBox {
  id          String   @id @default(cuid())
  name        String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  entries     MonthlyEntry[]
  adjustments ReserveAdjustment[]
}

/**
 * Movimento de caixinha que NÃO passa pela conta corrente: saldo de abertura,
 * rendimento, correção de digitação, conferência contra o extrato do banco.
 *
 * Não é MonthlyEntry de propósito. Depósito e retirada viram lançamento porque
 * o dinheiro atravessa a conta; rendimento não atravessa nada — se virasse
 * lançamento, o saldo de caixa do mês mostraria uma entrada ou saída que nunca
 * existiu.
 */
model ReserveAdjustment {
  id        String     @id @default(cuid())
  box       ReserveBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxId     String
  date      DateTime   @db.Date
  /** Diferença aplicada ao saldo: positiva soma, negativa tira. */
  amount    Decimal    @db.Decimal(12, 2)
  reason    String
  createdAt DateTime   @default(now())

  @@index([boxId, date])
}

// Reserva do dia a dia: teto diário de gasto variável (mercado, combustível,
// lanches). O que resta (amountPerDay × dias restantes do mês) é DESPESA do
// mês: entra como linha derivada na leitura (tela Mês, Panorama, Dashboard)
// e nunca é gravado nesta tabela — aqui mora só o valor por dia. Linha única
// (id "default").
model DailyBudget {
  id           String   @id @default("default")
  amountPerDay Decimal  @db.Decimal(12, 2)
  updatedAt    DateTime @updatedAt
}

// ============ INVESTIMENTOS (v1: Ações B3 + Dividendos) ============

// Posição na carteira: cotas + preço médio; cotação cacheada via brapi.dev.
model InvestmentAsset {
  id        String     @id @default(cuid())
  ticker    String     @unique // "BBSE3"
  name      String? // nome da empresa (vem da brapi)
  segment   String? // "SEGUROS" (organização do usuário)
  class     String     @default("STOCK") // v2: FII, CRYPTO…
  quantity  Int        @default(0)
  avgPrice  Decimal    @default(0) @db.Decimal(12, 4)
  lastPrice Decimal?   @db.Decimal(12, 4)
  priceAt   DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  dividends Dividend[]
  transactions InvestmentTransaction[]
}

// Negócio importado do relatório de Negociação da B3 (compra/venda).
// hash único = dedup: reimportar o mesmo relatório não duplica nem
// reaplica o efeito em cotas/PM.
model InvestmentTransaction {
  id        String          @id @default(cuid())
  asset     InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   String
  date      DateTime        @db.Date
  side      String // BUY | SELL
  quantity  Int
  price     Decimal         @db.Decimal(12, 4)
  value     Decimal         @db.Decimal(12, 2)
  hash      String          @unique
  createdAt DateTime        @default(now())

  @@index([assetId, date])
}

// Evento de provento (dividendo/JSCP): agenda + recebimento.
// LEGADO (2026-08-01): dividendos não geram mais lançamento mensal (o usuário
// reinveste tudo — spec dividendos-sem-receita). entryId fica só para evitar
// migração; nada lê ou escreve a coluna.
model Dividend {
  id        String          @id @default(cuid())
  asset     InvestmentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId   String
  type      String // "Dividendos" | "JSCP" | "Rendimento"
  exDate    DateTime?       @db.Date
  payDate   DateTime        @db.Date
  quantity  Int
  unitValue Decimal         @db.Decimal(12, 6)
  gross     Decimal         @db.Decimal(12, 2)
  net       Decimal         @db.Decimal(12, 2)
  received  Boolean         @default(false)
  entryId   String?
  createdAt DateTime        @default(now())

  @@index([assetId, payDate])
  @@index([received, payDate])
}
